{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zenabm.com/schemas/value-brief.json",
  "title": "ValueBrief",
  "description": "A concise first-week growth brief whose claims and actions resolve to checked evidence IDs.",
  "type": "object",
  "required": ["briefId", "trialId", "headline", "opportunities", "nextStep", "coverage"],
  "properties": {
    "briefId": { "type": "string", "minLength": 1 },
    "trialId": { "type": "string", "minLength": 1 },
    "headline": { "type": "string", "minLength": 1 },
    "opportunities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["findingId", "claim", "recommendation", "sourceIds", "coverage", "confidence"],
        "properties": {
          "findingId": { "type": "string", "minLength": 1 },
          "claim": { "type": "string", "minLength": 1 },
          "recommendation": { "type": "string", "minLength": 1 },
          "sourceIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "coverage": { "enum": ["complete", "partial", "unknown"] },
          "confidence": { "enum": ["high", "medium", "low", "unknown"] },
          "limitations": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "coverage": { "const": "unknown" } }, "required": ["coverage"] },
            "then": {
              "properties": {
                "confidence": { "const": "unknown" },
                "limitations": { "type": "array", "minItems": 1 }
              },
              "required": ["limitations"]
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "nextStep": { "type": "string", "minLength": 1 },
    "coverage": { "enum": ["complete", "partial", "unknown"] },
    "limitations": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false
}
