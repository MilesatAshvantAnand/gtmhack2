{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zenabm.com/schemas/audit-finding.json",
  "title": "AuditFinding",
  "description": "One evidence-linked own-data or public-data finding with an explicit coverage state.",
  "type": "object",
  "required": [
    "findingId",
    "trialId",
    "category",
    "claim",
    "recommendation",
    "coverage",
    "confidence",
    "sourceIds"
  ],
  "properties": {
    "findingId": { "type": "string", "minLength": 1 },
    "trialId": { "type": "string", "minLength": 1 },
    "category": {
      "enum": [
        "ad_count_health",
        "format_efficiency",
        "campaign_trend",
        "account_engagement",
        "deal_influence",
        "competitor_activity",
        "qualification"
      ]
    },
    "claim": { "type": "string", "minLength": 1 },
    "recommendation": { "type": "string", "minLength": 1 },
    "coverage": { "enum": ["complete", "partial", "unknown"] },
    "confidence": { "enum": ["high", "medium", "low", "unknown"] },
    "sourceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "limitations": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "coverage": { "const": "unknown" } }, "required": ["coverage"] },
      "then": {
        "properties": {
          "confidence": { "const": "unknown" },
          "limitations": { "type": "array", "minItems": 1 }
        },
        "required": ["limitations"]
      }
    }
  ],
  "additionalProperties": false
}
