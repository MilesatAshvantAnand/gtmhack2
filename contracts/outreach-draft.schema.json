{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zenabm.com/schemas/outreach-draft.json",
  "title": "OutreachDraft",
  "description": "A review-only message draft. This contract has no send, schedule, or launch operation.",
  "type": "object",
  "required": ["draftId", "trialId", "channel", "status", "body", "sourceIds", "humanReview"],
  "properties": {
    "draftId": { "type": "string", "minLength": 1 },
    "trialId": { "type": "string", "minLength": 1 },
    "channel": { "enum": ["email", "linkedin"] },
    "status": { "const": "draft" },
    "subject": { "type": "string", "minLength": 1 },
    "body": { "type": "string", "minLength": 1 },
    "sourceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "humanReview": { "const": "required" }
  },
  "additionalProperties": false
}
